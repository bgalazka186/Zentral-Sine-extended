{
  "_documentation": {
    "purpose": "Settings schema and category/section metadata owned by video.",
    "consumer": "features/settings/controllers/ZentralSettingsCatalog.js reads schema/settings; Runtime filters availability, UI controllers render controls.",
    "feature_source": "features/video/ZentralVideoPreview.uc.js",
    "contract": "This object is data only. Missing descriptor hides owner settings; it does not start or unload the feature. Keep property/defaultValue and category IDs synchronized with preferences.json and features/settings/layout.json."
  },
  "owner": "video",
  "schema": [
    {
      "property": "zen.workspace.zentral.video_preview.enabled",
      "label": "Sidebar Video Preview",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.video_preview.renderer",
      "label": "Preview method (Automatic tries native, streams, then still captures)",
      "type": "dropdown",
      "defaultValue": "auto",
      "options": [
        {
          "label": "Automatic",
          "value": "auto"
        },
        {
          "label": "Native cloning · frame",
          "value": "frame-native"
        },
        {
          "label": "Native cloning · actor",
          "value": "native"
        },
        {
          "label": "Video stream · frame",
          "value": "frame-stream"
        },
        {
          "label": "Video stream · actor",
          "value": "stream"
        },
        {
          "label": "Canvas stream",
          "value": "canvas-stream"
        },
        {
          "label": "Video frames",
          "value": "canvas"
        },
        {
          "label": "Page snapshots",
          "value": "snapshot"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.video_preview.selected_mode_only",
      "label": "Use only the selected method (disable fallback; ignored for Automatic)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.video_preview.keep_source_visible",
      "label": "Keep video on its page while visible (defer native cloning)",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.video_preview.youtube_captions",
      "label": "Mirror captions (text tracks and YouTube)",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.video_preview.auto_show_video",
      "label": "Automatically Preview Playing Videos",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.video_preview.require_audio",
      "label": "Only Offer Videos With Audio Tracks (mute state does not matter)",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.video_preview.hide_muted_duplicates",
