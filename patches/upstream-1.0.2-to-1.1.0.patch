+}
+#zen-app-panel-root[data-floating="true"] .zen-app-resize-strip {
+  display: none !important;
+  pointer-events: none !important;
+}
+#zen-app-panel-root[data-floating="true"][data-pill-side="left"] #zen-app-panel-pill {
+  left: 0 !important;
