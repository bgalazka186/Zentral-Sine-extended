- *   .zen-app-resize-strip-bottom; .zen-app-resize-strip-top; .zen-app-tile; .zs-restart-btn
- * Attribute selectors used: bgalazka-hover-panel-hidden; bgalazka-opposite-docking;
- *   bgalazka-panel-input-shield; bgalazka-pill-peek-dot; bgalazka-translucency; closing; data-insta-peek;
- *   data-loaded; data-panel-side; data-pinned; data-tab-loaded; open; zentral-app-panel-open;
- *   zentral-apps-placement
