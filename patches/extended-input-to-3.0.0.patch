+      const api = {
+        refresh: syncRssFolderDisplay,
+        destroy() {
+          if (disposed) return;
+          disposed = true;
+          nativeBinding?.destroy();
+          if (window.ZentralRuntime?.services.rss === api)
+            delete window.ZentralRuntime.services.rss;
+          cleanups
+            .splice(0)
+            .reverse()
+            .forEach((fn) => fn());
+        },
