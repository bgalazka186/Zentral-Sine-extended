+/* Independent caption presentation. Inspired by Zenslop's separate caption
+ * surface (b5ce39ede14a09c0095aa822ea380cbca8d236f0); implemented for Extended's
+ * existing card, without copying its capture engine or adding caption polling. */
+(function () {
+  "use strict";
+  window.ZentralModuleLoader.define("video/caption-layout",()=>({
+    apply({box,picture,captionNode,placement="below",fontSize=12,maxLines=4}) {
+      if(!box || !picture || !captionNode)return;
+      placement=placement==="overlay" ? "overlay":"below";
+      if(box.getAttribute("data-caption-placement")!==placement)box.setAttribute("data-caption-placement",placement);
+      if(placement==="below") {
+        if(captionNode.parentNode!==box || picture.nextElementSibling!==captionNode)picture.after(captionNode);
+      } else if(captionNode.parentNode!==picture)picture.appendChild(captionNode);
+      fontSize=Math.max(10,Math.min(28,Number(fontSize)||12));
+      maxLines=Math.max(1,Math.min(8,Number(maxLines)||4));
+      for(const [key,value] of [["--zentral-caption-font-size",fontSize+"px"],["--zentral-caption-max-lines",String(maxLines)]])
+        if(box.style.getPropertyValue(key)!==value)box.style.setProperty(key,value);
+      captionNode.setAttribute("aria-live","off");
+    },
+  }));
+})();
