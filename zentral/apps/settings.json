{
  "_documentation": {
    "purpose": "Settings schema and category/section metadata owned by apps.",
    "consumer": "extension/settings/controllers/ZentralSettingsCatalog.js reads schema/settings; Runtime filters availability, UI controllers render controls.",
    "feature_source": "zentral/apps/ZentralApps.uc.js",
    "contract": "This object is data only. Missing descriptor hides owner settings; it does not start or unload the feature. Keep property/defaultValue and category IDs synchronized with preferences.json and extension/settings/layout.json."
  },
  "owner": "apps",
  "schema": [
    {
      "property": "zen.workspace.apps.sidebar.enabled",
      "label": "Enable Apps Sidebar Grid & Floating Panels",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.apps.sidebar.apps_per_row",
      "label": "Apps Displayed Per Row",
      "type": "string",
      "defaultValue": 7
    },
    {
      "property": "zen.workspace.apps.sidebar.max_rows",
      "label": "Maximum Grid Rows",
      "type": "string",
      "defaultValue": 3
    },
    {
      "property": "zen.workspace.apps.sidebar.max_apps",
      "label": "Maximum Apps",
      "type": "string",
      "defaultValue": 21
    },
    {
      "property": "zen.workspace.apps.sidebar.hide_utility_section",
      "label": "Hide Utility Section in App Box",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.apps.sidebar.autohide",
      "label": "Autohide Apps Sidebar",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.apps.sidebar.placement",
      "label": "Apps Placement",
      "type": "dropdown",
      "defaultValue": "sidebar",
      "options": [
        {
          "label": "sidebar",
          "value": "sidebar"
        },
        {
          "label": "vertical-bar",
          "value": "vertical-bar"
        }
      ]
    },
    {
      "property": "zen.workspace.apps.sidebar.width",
      "label": "Panel Width (px)",
      "type": "string",
      "defaultValue": 350
    },
    {
      "property": "zen.workspace.apps.sidebar.animation_speed",
      "label": "Panel Animation Duration (ms)",
      "type": "string",
      "defaultValue": 450
    },
    {
      "property": "zen.workspace.apps.sidebar.animation_type",
      "label": "Panel Animation Easing Curve",
      "type": "dropdown",
      "defaultValue": "spring-gentle",
      "options": [
        {
          "label": "Smooth Slide",
          "value": "slide"
        },
        {
          "label": "Snappy Spring",
          "value": "spring-snappy"
        },
        {
          "label": "Gentle Spring",
          "value": "spring-gentle"
        },
        {
          "label": "Bouncy Spring",
          "value": "spring-bouncy"
        },
        {
          "label": "Elastic",
          "value": "elastic"
        },
        {
          "label": "Instant",
          "value": "none"
        }
      ]
    },
    {
      "property": "zen.workspace.apps.sidebar.badge_poll_interval_ms",
      "label": "Notification badge fallback refresh",
      "type": "string",
      "defaultValue": 0
    },
    {
      "property": "zen.workspace.apps.insta_peek.shortcut",
      "label": "Insta-Peek Shortcut",
      "type": "string",
      "defaultValue": "Alt+Q"
    }
  ],
  "settings": {
    "zen.workspace.apps.sidebar.enabled": {
      "category": "essentials",
      "section": "Essential features",
      "owner": "apps"
    },
    "zen.workspace.apps.sidebar.apps_per_row": {
      "category": "density",
      "section": "App grid",
      "owner": "apps"
    },
    "zen.workspace.apps.sidebar.max_rows": {
      "category": "density",
      "section": "App grid",
      "owner": "apps"
    },
    "zen.workspace.apps.sidebar.max_apps": {
      "category": "density",
      "section": "App grid",
      "owner": "apps"
    },
    "zen.workspace.apps.sidebar.hide_utility_section": {
      "category": "theme-details",
      "section": "Tabs, folders & launchers",
      "owner": "apps"
    },
    "zen.workspace.apps.sidebar.autohide": {
      "category": "apps",
      "section": "Launcher grid & placement",
      "owner": "apps"
    },
    "zen.workspace.apps.sidebar.placement": {
      "category": "density",
      "section": "App grid",
      "owner": "apps"
    },
    "zen.workspace.apps.sidebar.width": {
      "category": "density",
      "section": "Panel size & position",
      "owner": "apps"
    },
    "zen.workspace.apps.sidebar.animation_speed": {
      "category": "theme-details",
      "section": "Panel position & motion",
      "owner": "apps"
    },
    "zen.workspace.apps.sidebar.animation_type": {
      "category": "theme-details",
      "section": "Panel position & motion",
      "owner": "apps"
    },
    "zen.workspace.apps.sidebar.badge_poll_interval_ms": {
      "category": "notifications",
      "section": "Notification refresh",
      "owner": "apps"
    },
    "zen.workspace.apps.insta_peek.shortcut": {
      "category": "shortcuts",
      "section": "Insta Peek",
      "owner": "apps"
    }
  }
}
