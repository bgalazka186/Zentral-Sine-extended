{
  "id": "video",
  "themeId": "zentral-video-preview",
  "name": "Zentral Sidebar Video Preview",
  "description": "Video preview card in Zen's sidebar: pick a playing video from any tab, see it live, control playback, captions and a temporary enlarged view. Standalone part of Zentral Extended.",
  "version": "3.0.2",
  "entry": "ZentralVideoPreview.uc.js",
  "output": "ZentralVideoPreview.standalone.uc.js",
  "settings": "settings.json",
  "css": "ZentralVideoPreview.css",
  "loader": "__zentralVideoLoader",
  "include": [
    "controllers/ZentralVideoCaptionLayout.js",
    "controllers/ZentralVideoCaptions.js",
    "controllers/ZentralVideoDiscovery.js",
    "controllers/ZentralVideoEnlarge.js",
    "controllers/ZentralVideoPlayerInput.js",
    "controllers/ZentralVideoRendering.js",
    "controllers/ZentralVideoScheduling.js",
    "controllers/ZentralVideoSidebar.js",
    "controllers/ZentralVideoTransport.js"
  ],
  "texts": [
    "content/ZentralVideoBasicFrame.js",
    "content/ZentralVideoFrame.js"
  ],
  "assets": [
    "content/ZentralVideoActor.sys.mjs"
  ],
  "extras": [
    "standalone/ZentralVideoControlsLook.js"
  ],
  "replacements": [
    {
      "file": "controllers/ZentralVideoTransport.js",
      "from": "additional/video/content/ZentralVideoActor.sys.mjs",
      "to": "content/ZentralVideoActor.sys.mjs"
    }
  ],
  "excludePrefs": {
    "reason": "These Look prefs only take effect inside the full pack's Atelier look (colors, padding, border, row height, source style, opacities); the standalone card uses its own stylesheet defaults.",
    "properties": [
      "zen.workspace.bgalazka.look.video_opacity",
      "zen.workspace.bgalazka.look.video_control_opacity",
      "zen.workspace.bgalazka.look.video_canvas",
      "zen.workspace.bgalazka.look.video_control",
      "zen.workspace.bgalazka.look.video_text",
      "zen.workspace.bgalazka.look.video_muted",
      "zen.workspace.bgalazka.look.video_selected",
      "zen.workspace.bgalazka.look.video_border",
      "zen.workspace.bgalazka.look.video_padding",
      "zen.workspace.bgalazka.look.video_row_height",
      "zen.workspace.bgalazka.look.video_source_style"
    ]
  },
  "tags": [
    "video",
    "sidebar",
    "zen"
  ],
  "fullPackOnly": [
    "snapshot"
  ],
  "borrowedSettings": [
    {
      "from": "zentral/apps/settings.json",
      "properties": [
        "zen.workspace.apps.insta_peek.shortcut"
      ]
    }
  ],
  "externalPrefs": [
    "zen.tabs.vertical.right-side",
    "zen.workspace.bgalazka.panel_retry_limit",
    "ui.mouse.double_click_interval"
  ]
}
