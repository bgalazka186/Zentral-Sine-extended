{
  "owner": "colorful-folders",
  "schema": [
    {
      "property": "zen.workspace.zentral.folder_colors.enabled",
      "label": "Enable Colorful Folders",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.folder_colors.menu",
      "label": "Add folder colors to right-click menus",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.folder_colors.mode",
      "label": "Color editor mode",
      "type": "dropdown",
      "defaultValue": "simple",
      "options": [
        {
          "label": "Simple — a primary and a secondary (outline) color",
          "value": "simple"
        },
        {
          "label": "Detailed — edit each part separately",
          "value": "detailed"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.folder_colors.ignore_label",
      "label": "Ignore my folder label color (let the Zen theme decide the name color)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_base",
      "label": "Default folder base color (empty follows Zen)",
      "type": "string",
      "defaultValue": "",
      "control": "color"
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_back",
      "label": "Default Folder icon · back (optional detail override)",
      "type": "string",
      "defaultValue": "",
      "control": "color"
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_front",
      "label": "Default Folder icon · front (optional detail override)",
      "type": "string",
      "defaultValue": "",
      "control": "color"
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_stroke",
      "label": "Default Folder icon · outline and glyph (optional detail override)",
      "type": "string",
      "defaultValue": "",
      "control": "color"
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_label",
      "label": "Default Folder name (optional detail override)",
      "type": "string",
      "defaultValue": "",
      "control": "color"
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_accent",
      "label": "Default Group accent and line (optional detail override)",
      "type": "string",
      "defaultValue": "",
      "control": "color"
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_tint",
      "label": "Default Soft background tint (optional detail override)",
      "type": "string",
      "defaultValue": "",
      "control": "color"
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_hover",
      "label": "Default Hover background (optional detail override)",
      "type": "string",
      "defaultValue": "",
      "control": "color"
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_back_opacity",
      "label": "Default Folder icon back transparency (-1 = inherit; 0% = transparent, 100% = solid)",
      "type": "input",
      "defaultValue": -1,
      "control": "slider",
      "numeric": {
        "min": -1,
        "max": 100,
        "unit": "%"
      }
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_front_opacity",
      "label": "Default Folder icon front transparency (-1 = inherit; 0% = transparent, 100% = solid)",
      "type": "input",
      "defaultValue": -1,
      "control": "slider",
      "numeric": {
        "min": -1,
        "max": 100,
        "unit": "%"
      }
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_stroke_opacity",
      "label": "Default Folder icon outline and glyph transparency (-1 = inherit; 0% = transparent, 100% = solid)",
      "type": "input",
      "defaultValue": -1,
      "control": "slider",
      "numeric": {
        "min": -1,
        "max": 100,
        "unit": "%"
      }
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_label_opacity",
      "label": "Default Folder name transparency (-1 = inherit; 0% = transparent, 100% = solid)",
      "type": "input",
      "defaultValue": -1,
      "control": "slider",
      "numeric": {
        "min": -1,
        "max": 100,
        "unit": "%"
      }
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_accent_opacity",
      "label": "Default Group accent and line transparency (-1 = inherit; 0% = transparent, 100% = solid)",
      "type": "input",
      "defaultValue": -1,
      "control": "slider",
      "numeric": {
        "min": -1,
        "max": 100,
        "unit": "%"
      }
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_tint_opacity",
      "label": "Default Soft background tint transparency (-1 = inherit; 0% = transparent, 100% = solid)",
      "type": "input",
      "defaultValue": -1,
      "control": "slider",
      "numeric": {
        "min": -1,
        "max": 100,
        "unit": "%"
      }
    },
    {
      "property": "zen.workspace.zentral.folder_colors.default_hover_opacity",
      "label": "Default Hover background transparency (-1 = inherit; 0% = transparent, 100% = solid)",
      "type": "input",
      "defaultValue": -1,
      "control": "slider",
      "numeric": {
        "min": -1,
        "max": 100,
        "unit": "%"
      }
    }
  ],
