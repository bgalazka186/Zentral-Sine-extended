{
  "owner": "library-resize",
  "schema": [
    {
      "property": "zen.workspace.zentral.experimental.library_resize",
      "label": "Make Library behave more like Zentral panel (experimental)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.experimental.library_resize.mode",
      "label": "Library layout mode",
      "type": "dropdown",
      "defaultValue": "resize",
      "options": [
        {
          "label": "Resize webpage",
          "value": "resize"
        },
        {
          "label": "Overlay webpage",
          "value": "overlay"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.experimental.library_resize.minimum_content_width_px",
      "label": "Minimum webpage width (px; may overlap Library in narrow windows)",
      "type": "string",
      "defaultValue": 200
    },
    {
      "property": "zen.workspace.zentral.experimental.library_resize.animate_content",
      "label": "Resize webpage continuously during Library animation (more page layout work)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.library.custom_background",
      "label": "Use a custom Zen Library background color (overrides Arc 2.0 matching)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.library.custom_background.color",
      "label": "Custom Library background color (CSS color, e.g. #1e1e24, #1e1e24cc or rgba(30, 30, 36, 0.85))",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.library.custom_background.opacity",
      "label": "Custom Library background opacity (multiplies any alpha already in the color)",
      "type": "string",
      "defaultValue": 100
    }
  ],
  "settings": {
    "zen.workspace.zentral.experimental.library_resize": {
      "category": "experimental",
      "section": "Library layout",
      "owner": "library-resize"
    },
    "zen.workspace.zentral.experimental.library_resize.minimum_content_width_px": {
      "category": "experimental",
      "section": "Library layout",
      "owner": "library-resize"
    },
    "zen.workspace.zentral.experimental.library_resize.animate_content": {
      "category": "experimental",
      "section": "Library layout",
      "owner": "library-resize"
    },
    "zen.workspace.zentral.experimental.library_resize.mode": {
      "category": "experimental",
      "section": "Library layout",
      "owner": "library-resize"
    },
    "zen.workspace.zentral.library.custom_background": {
      "category": "theme-details",
      "section": "Compatibility styling",
      "owner": "library-resize"
    },
    "zen.workspace.zentral.library.custom_background.color": {
      "category": "theme-details",
      "section": "Compatibility styling",
      "owner": "library-resize"
    },
    "zen.workspace.zentral.library.custom_background.opacity": {
      "category": "theme-details",
      "section": "Compatibility styling",
      "owner": "library-resize"
    }
  }
}
