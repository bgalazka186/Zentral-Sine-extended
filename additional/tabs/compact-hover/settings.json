{
  "_documentation": {
    "purpose": "Opt-in extra edge tolerance and close grace for the compact tab sidebar. Zen 1.23.4b already prevents the sidebar from hiding while the pointer is over it (upstream gh-15995 / PR #16001); this switch only adds tolerance around an already-visible sidebar and a short grace before it may close, plus the 1500 ms window-exit grace. Off by default.",
    "feature_source": "additional/tabs/compact-hover/ZentralCompactHover.uc.js"
  },
  "owner": "compact-hover",
  "schema": [
    {
      "property": "zen.workspace.zentral.experimental.sidebar_startup_recalculate",
      "label": "Expand and restore sidebar after startup (experimental)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.experimental.sidebar_startup_recalculate.delay_seconds",
      "label": "Sidebar layout refresh delay (seconds)",
      "type": "string",
      "defaultValue": 0
    },
    {
      "property": "zen.workspace.zentral.experimental.sidebar_startup_recalculate.target_width_px",
      "label": "Sidebar expansion target width (px)",
      "type": "string",
      "defaultValue": 400,
      "validation": {
        "mode": "integer",
        "min": 0
      }
    },
    {
      "property": "zen.workspace.zentral.experimental.sidebar_startup_recalculate.extra_width_px",
      "label": "Sidebar expansion extra width (px)",
      "type": "string",
      "defaultValue": 100,
      "validation": {
        "mode": "integer",
        "min": 0
      }
    },
