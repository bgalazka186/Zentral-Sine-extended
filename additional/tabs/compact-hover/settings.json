    },
    {
      "property": "zen.workspace.zentral.experimental.compact_sidebar_hover",
      "label": "Keep compact tab sidebar open near its edge (experimental)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.experimental.compact_sidebar_hover.edge_margin_px",
      "label": "Compact sidebar edge tolerance (px)",
      "type": "string",
      "defaultValue": 12,
