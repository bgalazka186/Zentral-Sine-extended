{
  "owner": "notes",
  "schema": [
    {
      "property": "zen.workspace.zentral.notes.enabled",
      "label": "Enable Notes (note button on panel bars and shortcut)",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.show_button",
      "label": "Show the Notes button on panel URL bars",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.dock_sidebar",
      "label": "Dock Notes to the sidebar (opens beside the sidebar and adds a Notes button to it)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.avoid_sidebar",
      "label": "Keep the standalone Notes card clear of the native sidebar (opens on the opposite side and cannot be dragged under it)",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.shortcut",
      "label": "Notes shortcut (needs Alt, Ctrl or Cmd, e.g. Alt+Shift+N)",
      "type": "string",
      "defaultValue": "Alt+Shift+N"
    },
    {
      "property": "zen.workspace.zentral.notes.autosave_seconds",
      "label": "Longest time between saves while typing (seconds, 2–60)",
      "type": "input",
      "defaultValue": 5,
      "numeric": {
        "min": 2,
        "max": 60,
        "unit": "s"
      }
    },
    {
      "property": "zen.workspace.zentral.notes.folder",
      "label": "Notes folder (absolute path; empty = zentral-notes inside your profile)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.wrap_lines",
      "label": "Wrap long lines (off = scroll sideways to see the whole line)",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.font_size",
      "label": "Text size (px, 8–40)",
      "type": "input",
      "defaultValue": 13,
      "options": [
        {
          "label": "11 px",
          "value": 11
        },
        {
          "label": "12 px",
          "value": 12
        },
        {
          "label": "13 px",
          "value": 13
        },
        {
          "label": "14 px",
          "value": 14
        },
        {
          "label": "16 px",
          "value": 16
        },
        {
          "label": "18 px",
          "value": 18
        },
        {
          "label": "20 px",
          "value": 20
        },
        {
          "label": "24 px",
          "value": 24
        }
      ],
      "numeric": {
        "min": 8,
        "max": 40,
        "unit": "px"
      }
    },
    {
      "property": "zen.workspace.zentral.notes.line_height",
      "label": "Line height (%, 100–300)",
      "type": "input",
      "defaultValue": 160,
      "options": [
        {
          "label": "120%",
          "value": 120
        },
        {
          "label": "140%",
          "value": 140
        },
        {
          "label": "160%",
          "value": 160
        },
        {
          "label": "180%",
          "value": 180
        },
        {
          "label": "200%",
          "value": 200
        },
        {
          "label": "240%",
          "value": 240
        }
      ],
      "numeric": {
        "min": 100,
        "max": 300,
        "unit": "%"
      }
    },
    {
      "property": "zen.workspace.zentral.notes.blank_lines",
      "label": "Blank lines in read view",
      "type": "dropdown",
      "defaultValue": "collapse",
      "options": [
        {
          "label": "Collapse – any number of blank lines is one paragraph break",
          "value": "collapse"
        },
        {
          "label": "Keep – every extra blank line adds empty space",
          "value": "keep"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.line_breaks",
      "label": "Single line breaks in read view",
      "type": "dropdown",
      "defaultValue": "break",
      "options": [
        {
          "label": "Break – a new line stays a new line",
          "value": "break"
        },
        {
          "label": "Join – a new line is a space (standard Markdown)",
          "value": "join"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.read_copy",
      "label": "Select and copy text in the read view",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.setext",
      "label": "Treat text over a line of === or --- as a heading (off = --- is a horizontal rule)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.paste_link",
      "label": "Pasting a web address in the editor",
      "type": "dropdown",
      "defaultValue": "ask",
      "options": [
        {
          "label": "Ask – offer to create a link",
          "value": "ask"
        },
        {
          "label": "Only over selected text",
          "value": "selection"
        },
        {
          "label": "Paste as plain text",
          "value": "off"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.shortcuts",
      "label": "Changed editor shortcuts (set in Notes → Quick settings → Keyboard shortcuts; empty = defaults)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.hidden_tools",
      "label": "Hidden editor buttons and shortcuts (set in Notes → Quick settings → Toolbar buttons; empty = all shown)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.hover_reveal",
      "label": "Tuck the card away on an outside click and bring it back by hovering its top edge (instead of closing it)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.push_page",
      "label": "Push the page aside while the standalone card is open (instead of covering it)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.split_window",
      "label": "Split view as a second window of the same size (instead of halving one window)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.theme",
      "label": "Notes theme",
      "type": "dropdown",
      "defaultValue": "zentral",
      "options": [
        {
          "label": "Zentral – follows the Zen look",
          "value": "zentral"
        },
        {
          "label": "Recommended – like the RSS card",
          "value": "recommended"
        },
        {
          "label": "Light",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        },
        {
          "label": "Paper",
          "value": "paper"
        }
      ]
    }
  ],
  "settings": {
