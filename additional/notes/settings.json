{
  "owner": "notes",
  "schema": [
    {
      "property": "zen.workspace.zentral.notes.enabled",
      "label": "Enable Notes (note button on panel bars and shortcut)",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.show_button",
      "label": "Show the Notes button on panel URL bars",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.dock_sidebar",
      "label": "Dock Notes to the sidebar (opens beside the sidebar and adds a Notes button to it)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.avoid_sidebar",
      "label": "Keep the standalone Notes card clear of the native sidebar (opens on the opposite side and cannot be dragged under it)",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.shortcut",
      "label": "Notes shortcut (needs Alt, Ctrl or Cmd, e.g. Alt+Shift+N)",
      "type": "string",
      "defaultValue": "Alt+Shift+N"
    },
    {
      "property": "zen.workspace.zentral.notes.autosave_seconds",
      "label": "Longest time between saves while typing (seconds, 2–60)",
      "type": "input",
      "defaultValue": 5,
      "numeric": {
        "min": 2,
        "max": 60,
        "unit": "s"
      }
    },
    {
      "property": "zen.workspace.zentral.notes.folder",
      "label": "Notes folder (absolute path; empty = zentral-notes inside your profile)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.wrap_lines",
      "label": "Wrap long lines (off = scroll sideways to see the whole line)",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.font_size",
      "label": "Text size (px, 8–40)",
      "type": "input",
      "defaultValue": 13,
      "options": [
        {
          "label": "11 px",
          "value": 11
        },
        {
          "label": "12 px",
          "value": 12
        },
        {
          "label": "13 px",
          "value": 13
        },
        {
          "label": "14 px",
          "value": 14
        },
        {
          "label": "16 px",
          "value": 16
        },
        {
          "label": "18 px",
          "value": 18
        },
        {
          "label": "20 px",
          "value": 20
        },
        {
          "label": "24 px",
          "value": 24
        }
      ],
      "numeric": {
        "min": 8,
        "max": 40,
        "unit": "px"
      }
    },
    {
      "property": "zen.workspace.zentral.notes.line_height",
      "label": "Line height (%, 100–300)",
      "type": "input",
      "defaultValue": 160,
      "options": [
        {
          "label": "120%",
          "value": 120
        },
        {
          "label": "140%",
          "value": 140
        },
        {
          "label": "160%",
          "value": 160
        },
        {
          "label": "180%",
          "value": 180
        },
        {
          "label": "200%",
          "value": 200
        },
        {
          "label": "240%",
          "value": 240
        }
      ],
      "numeric": {
        "min": 100,
        "max": 300,
        "unit": "%"
      }
    },
    {
      "property": "zen.workspace.zentral.notes.blank_lines",
      "label": "Blank lines in read view",
      "type": "dropdown",
      "defaultValue": "collapse",
      "options": [
        {
          "label": "Collapse – any number of blank lines is one paragraph break",
          "value": "collapse"
        },
        {
          "label": "Keep – every extra blank line adds empty space",
          "value": "keep"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.line_breaks",
      "label": "Single line breaks in read view",
      "type": "dropdown",
      "defaultValue": "break",
      "options": [
        {
          "label": "Break – a new line stays a new line",
          "value": "break"
        },
        {
          "label": "Join – a new line is a space (standard Markdown)",
          "value": "join"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.read_copy",
      "label": "Select and copy text in the read view",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.setext",
      "label": "Treat text over a line of === or --- as a heading (off = --- is a horizontal rule)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.paste_link",
      "label": "Pasting a web address in the editor",
      "type": "dropdown",
      "defaultValue": "ask",
      "options": [
        {
          "label": "Ask – offer to create a link",
          "value": "ask"
        },
        {
          "label": "Only over selected text",
          "value": "selection"
        },
        {
          "label": "Paste as plain text",
          "value": "off"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.shortcuts",
      "label": "Changed editor shortcuts (set in Notes → Quick settings → Keyboard shortcuts; empty = defaults)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.hidden_tools",
      "label": "Hidden editor buttons and shortcuts (set in Notes → Quick settings → Toolbar buttons; empty = all shown)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.hover_reveal",
      "label": "Tuck the card away on an outside click and bring it back by hovering its top edge (instead of closing it)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.push_page",
      "label": "Push the page aside while the standalone card is open (instead of covering it)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.split_window",
      "label": "Split view as a second window of the same size (instead of halving one window)",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.theme",
      "label": "Notes theme",
      "type": "dropdown",
      "defaultValue": "zentral",
      "options": [
        {
          "label": "Zentral – follows the Zen look",
          "value": "zentral"
        },
        {
          "label": "Recommended – like the RSS card",
          "value": "recommended"
        },
        {
          "label": "Light",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        },
        {
          "label": "Paper",
          "value": "paper"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.look_radius",
      "label": "Notes card corner radius (px, 0–60, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_border",
      "label": "Notes card border width (px, 0–8, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_shadow_blur",
      "label": "Shadow blur (px, 0–120, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_shadow_y",
      "label": "Shadow offset down (px, 0–60, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_shadow_alpha",
      "label": "Shadow strength (%, 0–100; 0 = no shadow; empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_opacity",
      "label": "Notes card background opacity (%, 0–100, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_padding",
      "label": "Notes card inner padding (px, 0–64, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_font",
      "label": "Notes text font",
      "type": "dropdown",
      "defaultValue": "auto",
      "options": [
        {
          "label": "Theme default",
          "value": "auto"
        },
        {
          "label": "Sans-serif",
          "value": "sans"
        },
        {
          "label": "Serif",
          "value": "serif"
        },
        {
          "label": "Monospace",
          "value": "mono"
        },
        {
          "label": "Rounded",
          "value": "rounded"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.look_editor_font",
      "label": "Editor font (edit mode)",
      "type": "dropdown",
      "defaultValue": "same",
      "options": [
        {
          "label": "Same as the notes text",
          "value": "same"
        },
        {
          "label": "Monospace",
          "value": "mono"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.look_heading",
      "label": "Heading color in read view (six-digit #RRGGBB, empty = text color)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_btn_size",
      "label": "Notes button size (px, 14–56, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_btn_radius",
      "label": "Notes button corner radius (px, 0–50, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_btn_style",
      "label": "Button style",
      "type": "dropdown",
      "defaultValue": "plain",
      "options": [
        {
          "label": "Plain",
          "value": "plain"
        },
        {
          "label": "Filled",
          "value": "filled"
        },
        {
          "label": "Outlined",
          "value": "outlined"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.look_btn_icon",
      "label": "Button icon color (six-digit #RRGGBB, empty = text color)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_btn_fill",
      "label": "Button fill color (six-digit #RRGGBB, empty = automatic)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_btn_border",
      "label": "Button border color (six-digit #RRGGBB, empty = automatic)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_bg",
      "label": "Card background color (six-digit #RRGGBB, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_text",
      "label": "Card text color (six-digit #RRGGBB, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_accent",
      "label": "Accent color (links, active items; six-digit #RRGGBB, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.look_line",
      "label": "Lines and card border color (six-digit #RRGGBB, empty = theme)",
      "type": "string",
      "defaultValue": ""
    },
    {
      "property": "zen.workspace.zentral.notes.capture_target",
      "label": "Add to note: default target of the shortcuts",
      "type": "dropdown",
      "defaultValue": "last",
      "options": [
        {
          "label": "Last open note",
          "value": "last"
        },
        {
          "label": "New note",
          "value": "new"
        },
        {
          "label": "Inbox note",
          "value": "inbox"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.capture_menu",
      "label": "Add to note: show the entry in the right-click menu",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.capture_date",
      "label": "Add to note: include the date",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.capture_time",
      "label": "Add to note: include the time",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.capture_source",
      "label": "Add to note: include the page title as the source",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.capture_link",
      "label": "Add to note: make the source a link to the page",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.capture_highlight",
      "label": "Add to note: link jumps to and highlights the selected text (needs a link)",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "property": "zen.workspace.zentral.notes.capture_checkbox",
      "label": "Add to note: add as an unchecked checklist item",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.capture_style",
      "label": "Add to note: style of the selected text",
      "type": "dropdown",
      "defaultValue": "quote",
      "options": [
        {
          "label": "Quote",
          "value": "quote"
        },
        {
          "label": "Plain text",
          "value": "plain"
        },
        {
          "label": "Bullet",
          "value": "bullet"
        },
        {
          "label": "Highlight",
          "value": "highlight"
        },
        {
          "label": "Callout",
          "value": "callout"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.capture_position",
      "label": "Add to note: where new entries go",
      "type": "dropdown",
      "defaultValue": "end",
      "options": [
        {
          "label": "End of the note",
          "value": "end"
        },
        {
          "label": "Top of the note",
          "value": "top"
        }
      ]
    },
    {
      "property": "zen.workspace.zentral.notes.capture_open",
      "label": "Add to note: open the note afterwards",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "property": "zen.workspace.zentral.notes.capture_inbox",
      "label": "Inbox note name (the note carrying this label collects quick captures)",
      "type": "string",
      "defaultValue": "Inbox"
    }
  ],
